CC=g++

OPENGLLIB= -lGL
GLEWLIB= -lGLEW
GLFWLIB = -lglfw
LIBS=$(OPENGLLIB) $(GLEWLIB) $(GLFWLIB)
LDFLAGS=-L/usr/local/lib 
CPPFLAGS=-I/usr/local/include -I./

BIN=ihateu
SRCS=ihateu.cpp gl_framework.cpp shader_util.cpp hierarchy_node.cpp primitives.cpp ihateumore.cpp
INCLUDES=gl_framework.hpp shader_util.hpp ihateu.hpp hierarchy_node.hpp primitives.hpp ihateumore.hpp

all: $(BIN)

$(BIN): $(SRCS) $(INCLUDES)
	g++ $(CPPFLAGS) $(SRCS) -o $(BIN) $(LDFLAGS) $(LIBS)

clean:
	rm -f *~ *.o $(BIN)
